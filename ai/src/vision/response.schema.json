            67
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "confidence_aggregation": {
          "const": "maximum_detection_score"
        },
        "detection_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "kb_food_id": {
          "type": "null"
        },
        "kb_mapping_status": {
          "const": "not_resolved"
        }
      }
    }
  }
}