APP_NAME=NutriPlan Backend
DEBUG=false
ENVIRONMENT=development
# ENV=dev is also supported; use only one environment setting.
VISION_PROVIDER=unavailable
# With VISION_PROVIDER=http, set both the inference and readiness URLs.
# VISION_URL=http://127.0.0.1:9000/analyze
# VISION_HEALTH_URL=http://127.0.0.1:9000/health
VISION_HEALTH_TIMEOUT_SECONDS=1
# Local VietFood demo (independent of the external vision provider).
LOCAL_MEAL_ANALYSIS_ENABLED=false
LOCAL_MEAL_ANALYSIS_DEVICE=cpu
DATABASE_URL=mysql://nutriplan_user:change_me@127.0.0.1:3306/nutriplan
